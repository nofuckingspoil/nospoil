{
  "crons": [
    {
      "path": "/api/cron/purge",
      "schedule": "0 4 * * *"
    },
    {
      "path": "/api/cron/nudge",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/revelation",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/tirages-suivi",
      "schedule": "0 */2 * * *"
    },
    {
      "path": "/api/cron/adresses",
      "schedule": "20 * * * *"
    },
    {
      "path": "/api/cron/desinscriptions",
      "schedule": "0 7 * * 1"
    }
  ],
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ]
}
